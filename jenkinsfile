pipeline {
    agent any  // Ejecutar en cualquier agente de Jenkins disponible

    environment {
        // Definir las credenciales de GitHub que configuraste en Jenkins
        GIT_CREDENTIALS = 'github-token'  // Reemplaza con el ID de tus credenciales en Jenkins
    }

    stages {
        stage('Checkout') {
            steps {
                // Clonar el repositorio de GitHub
                checkout([$class: 'GitSCM', 
                          branches: [[name: '*/develop']],  // Especifica la rama de donde se parte
                          doGenerateSubmoduleConfigurations: false, 
                          extensions: [], 
                          userRemoteConfigs: [[url: 'https://github.com/carolzuniga/proyecto-integrador-grupoo4.git', credentialsId: "${GIT_CREDENTIALS}"]]])  // Usa tus credenciales configuradas
            }
        }

        stage('Merge Develop into Main') {
            steps {
                script {
                    // Cambiar a la rama main
                    sh 'git checkout main'
                    
                    // Hacer el merge de develop en main con la opción --allow-unrelated-histories
                    sh 'git merge origin/develop --allow-unrelated-histories'
                    
                    // Confirmar el merge (si no hay conflictos)
                    sh 'git commit -m "Merge develop into main" || echo "No changes to commit"'
                    
                    // Pushear los cambios al repositorio remoto
                    sh 'git push origin main'
                }
            }
        }
    }

    post {
        success {
            echo 'Merge completado con éxito!'
        }
        failure {
            echo 'Hubo un error en el merge'
        }
    }
}


