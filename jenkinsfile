pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        // Repositorio y rama
        GIT_REPO   = "https://github.com/carolzuniga/proyecto-integrador-grupoo4.git"
        GIT_BRANCH = "feature/web-ubuntu"

        // Desarrollo (Proxmox)
        DEV_HOST = "10.50.30.250"
        DEV_USER = "grupo4"
        DEV_SSH  = "ssh-dev-ubuntu"   // <-- ID de la credencial SSH en jenkins
        DEV_PATH = "/opt/lampp/htdocs/web-ubuntu"

        // Producción (VMware) - usando agente Jenkins en la VM
        PROD_PATH   = "/var/www/html/web-ubuntu"
        PROD_DB_HOST = "172.16.10.19"
        PROD_DB_USER = "root"
        PROD_DB_PASS = "1234"
        PROD_DB_NAME = "clientes"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: env.GIT_BRANCH,
                    url: env.GIT_REPO
            }
        }

        stage('Deploy to DEV (Proxmox)') {
            steps {
                sshagent(credentials: [env.DEV_SSH]) {

                    sh """
                        echo "--- Copiando código a Desarrollo ---"

                        ssh ${DEV_USER}@${DEV_HOST} "sudo mkdir -p ${DEV_PATH}"

                        rsync -avz --delete . ${DEV_USER}@${DEV_HOST}:${DEV_PATH}/

                        echo "--- Reiniciando Apache en DEV ---"
                        ssh ${DEV_USER}@${DEV_HOST} "sudo /opt/lampp/lampp restartapache"
                    """
                }
            }
        }

        stage('Deploy to PRODUCCION (VMware)') {
            agent { label 'agent-produccion' }

            steps {
                sh """
                    echo "--- Preparando carpeta en producción ---"
                    sudo mkdir -p ${PROD_PATH}
                    sudo chown -R \$(whoami):\$(whoami) ${PROD_PATH}

                    echo "--- Sincronizando código desde GitHub ---"

                    if [ ! -d "${PROD_PATH}/.git" ]; then
                        rm -rf ${PROD_PATH}/*
                        git clone -b ${GIT_BRANCH} ${GIT_REPO} ${PROD_PATH}
                    else
                        cd ${PROD_PATH}
                        git fetch origin ${GIT_BRANCH}
                        git checkout ${GIT_BRANCH}
                        git pull origin ${GIT_BRANCH}
                    fi

                    echo "--- Reiniciando Apache en Producción ---"
                    sudo systemctl restart apache2 || sudo systemctl restart apache2.service || true
                """
            }
        }
    }
}

